    // ── Bottom tab bar ────────────────────────────────────────────────────────
    JPanel makeTabBar() {
        JPanel bar = new JPanel(new GridLayout(1, 4, 6, 0));        // create a JPanel with a GridLayout to serve as the bottom tab bar, which will contain 4 equally spaced buttons for the tabs (Learn, Quiz, Badges, Profile) while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
        bar.setBackground(Color.WHITE);     // set the background color of the tab bar to white, which helps to create a clean and visually appealing design that contrasts well with the colorful tab icons while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
        bar.setBorder(BorderFactory.createCompoundBorder(
            BorderFactory.createMatteBorder(1, 0, 0, 0, new Color(210, 210, 210)),
            new EmptyBorder(6, 10, 10, 10)));       // set a compound border for the tab bar that includes a matte border at the top to create a subtle separation from the main content area and an empty border for padding around the edges, which helps to enhance the visual appeal and organization of the tab bar while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
        bar.setPreferredSize(new Dimension(0, 72));     // set the preferred size of the tab bar to have a fixed height of 72 pixels while allowing the width to expand to fill the available space, which helps to maintain good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations

        String[] labels = { "Learn", "Quiz", "Badges", "Profile" };     // labels for the tabs in the bottom tab bar, which will be displayed below the corresponding icons to help users easily identify the purpose of each tab while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations

        for (int i = 0; i < 4; i++) {
            final int idx = i;      // need a final variable for the lambda expression below to capture the current index value for each button, which allows the correct tab to be shown when each button is clicked while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations

            TabBarIcon tabIcon = new TabBarIcon(i, TAB_COLORS[i], false);       // create a TabBarIcon for the current tab using the index to determine the type and color, which will be used as the icon for the corresponding button in the tab bar while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations

            Dimension iconBox = new Dimension(TabBarIcon.SIZE, TabBarIcon.SIZE);        // create a Dimension object for the size of the icon box, which will be used to set the preferred, minimum, and maximum size of the JLabel that contains the tab icon to ensure consistent sizing and alignment while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            JLabel lIcon = new JLabel(tabIcon);     // create a JLabel to hold the TabBarIcon for the current tab, which will be displayed above the corresponding label in the tab bar button to help users easily identify the purpose of each tab while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            lIcon.setHorizontalAlignment(SwingConstants.CENTER);        // set the horizontal alignment of the icon label to center, which helps to ensure that the tab icons are visually centered within their designated area in the tab bar while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            lIcon.setVerticalAlignment(SwingConstants.CENTER);      // set the vertical alignment of the icon label to center, which helps to ensure that the tab icons are visually centered within their designated area in the tab bar while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            lIcon.setPreferredSize(iconBox);        // set the preferred size of the icon label to the defined iconBox dimension, which helps to ensure that the tab icons are consistently sized and aligned within the tab bar while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            lIcon.setMinimumSize(iconBox);      // set the minimum size of the icon label to the defined iconBox dimension, which helps to ensure that the tab icons do not shrink below a certain size that would affect readability and visual appeal while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            lIcon.setMaximumSize(iconBox);      // set the maximum size of the icon label to the defined iconBox dimension, which helps to ensure that the tab icons do not grow beyond a certain size that would affect readability and visual appeal while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations

            JLabel lText = new JLabel(labels[i]);       // create a JLabel for the text label of the current tab using the corresponding label from the labels array, which will be displayed below the tab icon in the tab bar button to help users easily identify the purpose of each tab while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            lText.setFont(new Font("SansSerif", Font.PLAIN, 10));       // set the font of the text label to a sans-serif font with a plain style and size 10, which helps to ensure good readability and visual appeal for the tab labels while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            lText.setHorizontalAlignment(SwingConstants.CENTER);        // set the horizontal alignment of the text label to center, which helps to ensure that the tab labels are visually centered below their corresponding icons in the tab bar while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations

            JPanel stack = new JPanel();        // create a new JPanel to stack the icon label and text label vertically, which will be used as the content for each tab button in the tab bar while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            stack.setLayout(new BoxLayout(stack, BoxLayout.Y_AXIS));        // set the layout of the stack panel to a vertical BoxLayout, which allows the icon label and text label to be arranged vertically with proper spacing while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            stack.setOpaque(false);     // set the stack panel to be transparent, which allows the background of the tab bar to show through and helps to create a visually appealing design for the tab buttons while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            lIcon.setAlignmentX(Component.CENTER_ALIGNMENT);        // set the horizontal alignment of the icon label within the stack panel to center, which helps to ensure that the tab icons are visually centered within their designated area in the tab bar while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            lText.setAlignmentX(Component.CENTER_ALIGNMENT);        // set the horizontal alignment of the text label within the stack panel to center, which helps to ensure that the tab labels are visually centered below their corresponding icons in the tab bar while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            stack.add(lIcon);       // add the icon label to the stack panel, which will be displayed above the text label in the tab bar button to help users easily identify the purpose of each tab while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            stack.add(Box.createVerticalStrut(3));      // add a vertical strut of 3 pixels to the stack panel to create spacing between the icon label and text label, which helps to improve the visual appeal and readability of the tab buttons while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            stack.add(lText);       // add the text label to the stack panel, which will be displayed below the icon label in the tab bar button to help users easily identify the purpose of each tab while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations

            JPanel cell = new JPanel(new FlowLayout(FlowLayout.CENTER, 0, 0));      // create a new JPanel with a FlowLayout to serve as the cell for the tab button, which will contain the stack panel with the icon and text labels while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            cell.setOpaque(false);      // set the cell panel to be transparent, which allows the background of the tab bar to show through and helps to create a visually appealing design for the tab buttons while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            cell.add(stack);        // add the stack panel containing the icon and text labels to the cell panel, which will be used as the content for each tab button in the tab bar while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations

            JButton btn = new JButton();        // create a new JButton to serve as the tab button in the tab bar, which will contain the cell panel with the icon and text labels and will respond to user clicks to switch between tabs while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            btn.setLayout(new BorderLayout());      // set the layout of the button to BorderLayout, which allows the cell panel containing the icon and text labels to be centered within the button while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            btn.add(cell, BorderLayout.CENTER);     // add the cell panel containing the icon and text labels to the center of the button, which allows it to be visually centered within the tab bar while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            btn.setFocusPainted(false);     // disable the focus painting on the button to create a cleaner and more visually appealing design for the tab buttons while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            btn.setBorderPainted(false);        // disable the border painting on the button to create a cleaner and more visually appealing design for the tab buttons while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            btn.setContentAreaFilled(false);        // disable the content area filling on the button to create a cleaner and more visually appealing design for the tab buttons while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            btn.setMargin(new Insets(0, 0, 0, 0));      // set the margin of the button to zero on all sides to ensure that the content (icon and text) is properly aligned and spaced within the button while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            btn.setOpaque(false);       // set the button to be transparent, which allows the background of the tab bar to show through and helps to create a visually appealing design for the tab buttons while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            btn.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));      // set the cursor to a hand cursor when hovering over the button to indicate that it is clickable and enhance the user experience while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            btn.addActionListener(e -> showTab(idx));       // add an action listener to the button that calls the showTab method with the corresponding index when the button is clicked, which allows users to switch between tabs in the main content area while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations

            tabBtns[i] = btn;       // store a reference to the button in the tabBtns array for later use when updating the tab states, which allows the showTab method to access and update the appearance of the buttons based on the active tab while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            btn.putClientProperty("icon",     lIcon);       // store the icon label in the button's client properties for later access when updating the tab states, which allows the showTab method to access and update the appearance of the icons based on the active tab while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            btn.putClientProperty("label",    lText);       // store the text label in the button's client properties for later access when updating the tab states, which allows the showTab method to access and update the appearance of the labels based on the active tab while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            btn.putClientProperty("tabIcon",  tabIcon);     // store the TabBarIcon in the button's client properties for later access when updating the tab states, which allows the showTab method to access and update the appearance of the icons based on the active tab while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations

            bar.add(btn);       // add the button to the tab bar, which will display it as part of the bottom navigation and allow users to click on it to switch between tabs while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
        }
        return bar;     // return the constructed tab bar panel to be added to the main application window, which will provide the bottom navigation for switching between different content panels while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
    }

    void showTab(int idx) {
        String[] cards = { "LEARN", "QUIZ", "BADGES", "PROFILE" };      // identifiers for the different content panels in the CardLayout, which will be used to show the corresponding panel when a tab is selected while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
        cardLayout.show(cardPanel, cards[idx]);     // show the content panel corresponding to the selected tab using the CardLayout, which allows for smooth switching between different panels while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
        for (int i = 0; i < tabBtns.length; i++) {
            boolean active = (i == idx);        // determine if the current button is the active tab based on the index, which will be used to update the appearance of the buttons to indicate which tab is currently selected while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            Color c = TAB_COLORS[i];        // get the color for the current tab from the TAB_COLORS array, which will be used to update the appearance of the buttons to indicate which tab is currently selected while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            TabBarIcon tabIcon = (TabBarIcon) tabBtns[i].getClientProperty("tabIcon");      // retrieve the TabBarIcon from the button's client properties to update its appearance based on whether it is the active tab, which allows for visual feedback to indicate which tab is currently selected while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            JLabel icon  = (JLabel) tabBtns[i].getClientProperty("icon");       // retrieve the icon label from the button's client properties to update its appearance based on whether it is the active tab, which allows for visual feedback to indicate which tab is currently selected while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            JLabel label = (JLabel) tabBtns[i].getClientProperty("label");      // retrieve the text label from the button's client properties to update its appearance based on whether it is the active tab, which allows for visual feedback to indicate which tab is currently selected while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            if (tabIcon != null) {
                tabIcon.setColor(c);        // update the color of the TabBarIcon based on the corresponding tab color, which helps to visually differentiate the tabs and indicate which one is currently active while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
                tabIcon.setActive(active);      // update the active state of the TabBarIcon based on whether it is the selected tab, which helps to visually indicate which tab is currently active while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            }
            if (icon != null) icon.repaint();       // repaint the icon label to reflect any changes made to the TabBarIcon, which ensures that the visual updates are displayed correctly while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            if (label != null) {
                label.setForeground(active ? c.darker() : new Color(110, 110, 110));        // update the foreground color of the text label based on whether it is the active tab, using a darker shade of the tab color for the active tab and a neutral gray for inactive tabs, which helps to visually indicate which tab is currently active while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
                label.setFont(new Font("SansSerif", active ? Font.BOLD : Font.PLAIN, 10));      // update the font of the text label to be bold for the active tab and plain for inactive tabs, which helps to visually indicate which tab is currently active while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            }
        }
    }

    /** Rounded gradient badge icons for the bottom tab bar. */
    static final class TabBarIcon implements Icon {
        static final int SIZE  = 30;        // size of the icon, which defines the width and height of the circular badge that will be displayed in the bottom tab bar, contributing to a visually appealing and consistent design for the tab icons while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
        private static final int GLYPH = 22;        // size of the glyph inside the icon, which defines the area within the circular badge where the specific symbol (such as a book, question mark, star, or profile silhouette) will be drawn to represent each tab in the bottom navigation while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
        private final int type;     // type of the icon, which determines the specific glyph that will be drawn inside the circular badge to represent each tab in the bottom navigation (e.g., 0 for learn, 1 for quiz, 2 for badges, 3 for profile) while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
        private Color color;        // color of the icon, which will be used to create a gradient effect for the circular badge and will also influence the color of the glyph inside the badge, helping to visually differentiate the tabs and indicate which one is currently active while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
        private boolean active;     // active state of the icon, which indicates whether the tab represented by this icon is currently selected or not, and will be used to apply visual effects (such as a highlight or border) to indicate the active tab while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations

        TabBarIcon(int type, Color color, boolean active) {
            this.type   = type;     // initialize the type of the icon based on the provided parameter, which will determine the specific glyph that will be drawn inside the circular badge to represent each tab in the bottom navigation while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            this.color  = color;    // initialize the color of the icon based on the provided parameter, which will be used to create a gradient effect for the circular badge and will also influence the color of the glyph inside the badge, helping to visually differentiate the tabs and indicate which one is currently active while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            this.active = active;   // initialize the active state of the icon based on the provided parameter, which indicates whether the tab represented by this icon is currently selected or not, and will be used to apply visual effects (such as a highlight or border) to indicate the active tab while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
        }

        void setColor(Color color)  { this.color = color; }
        void setActive(boolean on)  { this.active = on; }

        @Override
        public int getIconWidth()  { return SIZE; }
        @Override
        public int getIconHeight() { return SIZE; }

        @Override
        public void paintIcon(Component c, Graphics g, int x, int y) {
            Graphics2D g2 = (Graphics2D) g.create();        // create a copy of the Graphics object to avoid modifying the original, which allows for custom drawing of the icon without affecting other components while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING,
                    RenderingHints.VALUE_ANTIALIAS_ON);     // enable antialiasing for smoother edges
            g2.translate(x, y);     // translate the graphics context to the specified (x, y) position where the icon should be drawn, which allows for proper placement of the icon within the tab button while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations

            int pad = 1;        // padding around the icon to create a margin between the edge of the circular badge and the area where the glyph will be drawn, which helps to improve the visual appeal and readability of the icon while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            int d   = SIZE - pad * 2;       // diameter of the circular badge, which is calculated by subtracting the padding from both sides of the icon size, defining the area where the gradient will be applied and the glyph will be drawn to represent each tab in the bottom navigation while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations

            Color top = color.brighter();       // get a brighter version of the icon color for the top gradient
            Color bot = color.darker();        // get a darker version of the icon color for the bottom gradient    
            g2.setPaint(new GradientPaint(0, pad, top, 0, pad + d, bot));       // create a vertical gradient paint from the top color to the bottom color, which will be used to fill the circular badge and create a visually appealing effect for the tab icons while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            g2.fillOval(pad, pad, d, d);        // fill an oval shape with the gradient paint to create the circular badge for the tab icon, which will visually represent each tab in the bottom navigation while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations

            if (active) {
                g2.setColor(new Color(255, 255, 255, 100));     // set a semi-transparent white color to create a highlight effect for the active tab, which helps to visually indicate which tab is currently selected while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
                g2.setStroke(new BasicStroke(2f));      // set a thicker stroke for drawing the highlight border around the active tab icon, which helps to visually differentiate the active tab from inactive tabs while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
                g2.drawOval(pad, pad, d, d);        // draw an oval border around the circular badge to create a highlight effect for the active tab, which helps to visually indicate which tab is currently selected while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            }

            g2.setColor(new Color(255, 255, 255, 245));     // set a mostly opaque white color for drawing the glyph inside the badge, which helps to ensure that the symbol representing each tab is clearly visible and stands out against the gradient background while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            int gx = (SIZE - GLYPH) / 2;        // calculate the x-coordinate for translating the graphics context to center the glyph within the circular badge, which ensures that the symbol representing each tab is properly aligned and visually appealing while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            int gy = (SIZE - GLYPH) / 2;        // calculate the y-coordinate for translating the graphics context to center the glyph within the circular badge, which ensures that the symbol representing each tab is properly aligned and visually appealing while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            g2.translate(gx, gy);       // translate the graphics context to the calculated position to center the glyph within the circular badge
            switch (type) {
                case 0: paintBook(g2);     break;       // draw the book glyph for the "Learn" tab, which visually represents the educational content and resources available in that section while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
                case 1: paintQuiz(g2);     break;       // draw the question mark glyph for the "Quiz" tab, which visually represents the interactive quizzes and assessments available in that section while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
                case 2: paintStar(g2);     break;       // draw the star glyph for the "Badges" tab, which visually represents the achievements and rewards that users can earn in that section while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
                default: paintProfile(g2); break;       // draw the profile silhouette glyph for the "Profile" tab, which visually represents the user's personal information and settings available in that section while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            }
            g2.dispose();       // dispose of the graphics context to free up resources, which is a good practice after custom drawing operations to ensure that system resources are managed efficiently while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
        }

        void paintBook(Graphics2D g) {
            g.fillRoundRect(2, 4, 8, 14, 2, 2);     // draw the left page of the book glyph using a rounded rectangle, which visually represents the educational content and resources available in the "Learn" tab while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            g.fillRoundRect(12, 4, 8, 14, 2, 2);        // draw the right page of the book glyph using a rounded rectangle, which visually represents the educational content and resources available in the "Learn" tab while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            g.setColor(new Color(255, 255, 255, 120));      // set a semi-transparent white color to draw the spine of the book glyph, which helps to visually differentiate the two pages and add depth to the icon while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            g.fillRect(10, 5, 2, 12);       // draw the spine of the book glyph using a rectangle, which visually represents the binding of the book and adds detail to the icon for the "Learn" tab while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
        }

        void paintQuiz(Graphics2D g) {
            g.setFont(new Font("SansSerif", Font.BOLD, 16));        // set the font for drawing the question mark glyph in the "Quiz" tab, which helps to ensure that the symbol is clearly visible and stands out within the circular badge while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            FontMetrics fm = g.getFontMetrics();        // get the font metrics for the current font to calculate the positioning of the question mark glyph, which allows for precise centering of the symbol within the circular badge while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            String mark = "?";      // the question mark glyph to represent the "Quiz" tab, which visually indicates the interactive quizzes and assessments available in that section while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            int tx = (GLYPH - fm.stringWidth(mark)) / 2;        // calculate the x-coordinate for drawing the question mark glyph to center it within the circular badge, which ensures that the symbol is properly aligned and visually appealing while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            int ty = (GLYPH + fm.getAscent() - fm.getDescent()) / 2;        // calculate the y-coordinate for drawing the question mark glyph to center it within the circular badge, which ensures that the symbol is properly aligned and visually appealing while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            g.drawString(mark, tx, ty);     // draw the question mark glyph at the calculated position to represent the "Quiz" tab, which visually indicates the interactive quizzes and assessments available in that section while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
        }

        void paintStar(Graphics2D g) {
            int[] xs = { 11, 13, 18, 14, 16, 11, 6, 8, 4, 9 };      // x-coordinates for the points of the star glyph to represent the "Badges" tab, which visually indicates the achievements and rewards available in that section while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            int[] ys = { 3, 8, 8, 11, 16, 13, 16, 11, 8, 8 };       // y-coordinates for the points of the star glyph to represent the "Badges" tab, which visually indicates the achievements and rewards available in that section while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            g.fillPolygon(xs, ys, 10);      // fill a polygon shape using the specified x and y coordinates to draw the star glyph for the "Badges" tab, which visually indicates the achievements and rewards available in that section while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
        }

        void paintProfile(Graphics2D g) {
            g.fillOval(6, 2, 10, 10);       // draw the head of the profile silhouette glyph for the "Profile" tab using an oval shape, which visually represents the user's personal information and settings available in that section while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
            g.fillRoundRect(3, 12, 16, 8, 6, 6);        // draw the shoulders and torso of the profile silhouette glyph for the "Profile" tab using a rounded rectangle, which visually represents the user's personal information and settings available in that section while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
        }
    }

    // ── Placeholder panel for unfinished modules ──────────────────────────────
    static JPanel makePlaceholder(String title, String msg, int tabIndex) {
        Color accent = TAB_COLORS[tabIndex];
        JPanel outer = new JPanel(new GridBagLayout());
        outer.setBackground(Color.WHITE);

        int cardW = WIDTH - 64;
        int textW = cardW - 56;

        Color accentSoft = new Color(
            Math.min(255, accent.getRed()   + 200),
            Math.min(255, accent.getGreen() + 200),
            Math.min(255, accent.getBlue()  + 200));

        JPanel card = new JPanel();
        card.setLayout(new BoxLayout(card, BoxLayout.Y_AXIS));
        card.setBackground(accentSoft);
        card.setBorder(BorderFactory.createCompoundBorder(
            BorderFactory.createLineBorder(accent, 2, true),
            new EmptyBorder(32, 28, 32, 28)));
        card.setAlignmentX(Component.CENTER_ALIGNMENT);
        card.setMaximumSize(new Dimension(cardW, 560));

        JLabel lIcon = new JLabel(new TabBarIcon(tabIndex, accent, true),
                SwingConstants.CENTER);
        lIcon.setAlignmentX(Component.CENTER_ALIGNMENT);
        lIcon.setMaximumSize(new Dimension(cardW - 56, TabBarIcon.SIZE + 4));

        JLabel lTitle = new JLabel(title, SwingConstants.CENTER);
        lTitle.setFont(new Font("Segoe UI", Font.BOLD, 22));
        lTitle.setForeground(accent.darker());
        lTitle.setAlignmentX(Component.CENTER_ALIGNMENT);
        lTitle.setMaximumSize(new Dimension(textW, 80));

        JTextArea lMsg = new JTextArea(msg);
        lMsg.setFont(new Font("Segoe UI", Font.PLAIN, 15));
        lMsg.setForeground(new Color(42, 42, 42));
        lMsg.setBackground(accentSoft);
        lMsg.setLineWrap(true);
        lMsg.setWrapStyleWord(true);
        lMsg.setEditable(false);
        lMsg.setFocusable(false);
        lMsg.setOpaque(false);
        lMsg.setBorder(null);
        lMsg.setAlignmentX(Component.CENTER_ALIGNMENT);
        Dimension msgDim = placeholderTextSize(lMsg, textW);
        lMsg.setPreferredSize(msgDim);
        lMsg.setMaximumSize(msgDim);
        lMsg.setMinimumSize(msgDim);

        JLabel lNote = new JLabel("  Coming soon  ", SwingConstants.CENTER);
        lNote.setFont(new Font("Segoe UI", Font.BOLD, 13));
        lNote.setForeground(Color.WHITE);
        lNote.setOpaque(true);
        lNote.setBackground(accent);
        lNote.setBorder(new EmptyBorder(8, 16, 8, 16));
        lNote.setAlignmentX(Component.CENTER_ALIGNMENT);
        lNote.setMaximumSize(new Dimension(textW, 40));

        card.add(lIcon);
        card.add(Box.createVerticalStrut(14));
        card.add(lTitle);
        card.add(Box.createVerticalStrut(16));
        card.add(lMsg);
        card.add(Box.createVerticalStrut(20));
        card.add(lNote);

        GridBagConstraints gbc = new GridBagConstraints();      
        gbc.gridx = 0;      
        gbc.gridy = 0;      
        gbc.weightx = 1.0;      
        gbc.weighty = 1.0;      
        gbc.anchor = GridBagConstraints.CENTER;     
        gbc.fill = GridBagConstraints.NONE;     
        outer.add(card, gbc);       

        return outer;       // return the constructed placeholder panel, which can be used for unfinished modules in the application while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
    }

    static Dimension placeholderTextSize(JTextArea area, int width) {
        area.setSize(new Dimension(width, Short.MAX_VALUE));        // set the size of the JTextArea to the specified width and an extremely large height to allow for proper text wrapping, which ensures that the text content is displayed correctly within the available space while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
        Dimension pref = area.getPreferredSize();       // calculate the preferred size of the JTextArea based on the specified width and an extremely large height to allow for proper text wrapping, which ensures that the text content is displayed correctly within the available space while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
        return new Dimension(width, pref.height + 4);       // add a small vertical padding to the preferred height of the text area to ensure that the text is not too close to the edges of the area, which helps to improve readability and visual appeal while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new Main().setVisible(true));      // launch the application by creating an instance of the Main class and making it visible on the Event Dispatch Thread, which ensures that the GUI is created and updated in a thread-safe manner while maintaining good readability and visual appeal across different screen sizes and content variations, contributing to a polished and user-friendly design for the learning module panel that effectively organizes the educational material while maintaining good readability and visual appeal across different screen sizes and content variations
    }
